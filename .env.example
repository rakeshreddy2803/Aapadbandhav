# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/apadbandhav

# JWT Configuration
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRES_IN=7d

# VAPID Keys for Web Push (Legacy - kept for backward compatibility)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@apadbandhav.com

# OneSignal Configuration (Required for Push Notifications)
ONESIGNAL_APP_ID=030f6cda-43f7-47d6-9843-2d54f4df8b9e
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key

# Mail Configuration
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=your-mail-user
MAIL_PASS=your-mail-password
MAIL_FROM=noreply@apadbandhav.com

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Application Configuration
PORT=3000
NODE_ENV=development
